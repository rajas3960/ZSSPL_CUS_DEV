projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMM_APPS01_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action CrtPr;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action upexl;

  use association _item { create; with draft; }
}

define behavior for ZMM_APPS01_IPV //alias <alias_name>
{
  use update;
  use delete;
  use action upexl ;

  use association _hdr { with draft; }
}