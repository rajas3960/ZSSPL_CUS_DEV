      IGSTAMT;
      @UI                 : { lineItem: [{ position: 300, label: 'CGST Amount' }],
      identification      : [{ position: 300, label: 'CGST Amount' }]    }
      CGSTAMT;
      @UI                 : { lineItem: [{ position: 310, label: 'SGST Amount' }],
