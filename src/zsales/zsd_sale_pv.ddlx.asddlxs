     // MATERIALVAL ;
       @UI                 : { lineItem: [{ position: 260, label: 'Net Weight' }],
      identification      : [{ position: 260, label: 'Net Weight' }]    }
      NETWEIGHT ;
      @UI                 : { lineItem: [{ position: 270, label: 'Gross Weight' }],
      identification      : [{ position: 270, label: 'Gross Weight' }]    }
      GROSSWEIGHT ;
      @UI                 : { lineItem: [{ position: 280, label: 'Total Net Amount' }],
