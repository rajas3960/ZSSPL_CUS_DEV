      BILLITNO   ;
      @UI                 : { lineItem: [{ position: 180, label: 'Product' }],
      identification      : [{ position: 180, label: 'Product' }]    }
      PRODUCT   ;
      @UI                 : { lineItem: [{ position: 190, label: 'HSN Code' }],
      identification      : [{ position: 190, label: 'HSN Code' }]      }
      HSNNO; 
       @UI                 : { lineItem: [{ position: 200, label: 'Quantity' }],
      identification      : [{ position: 200, label: 'Quantity' }]    }
      BILLQTY   ; 
