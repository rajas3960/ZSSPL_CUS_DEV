      docno   ;
      @UI                 : { lineItem: [{ position: 400, label: 'Cancelled' }],
      identification      : [{ position: 400, label: 'Cancelled' }]    }
      cancel    ;
      @UI                 : { lineItem: [{ position: 410, label: 'Cancelled Billing Document' }],
