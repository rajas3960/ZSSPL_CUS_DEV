     // TCS  ;
      @UI                 : { lineItem: [{ position: 330, label: 'Total Tax Amount' }],
      identification      : [{ position: 330, label: 'Total Tax Amount' }]    }
      taxamt ;
       @UI                 : { lineItem: [{ position: 340, label: 'Bill Amount' }],
