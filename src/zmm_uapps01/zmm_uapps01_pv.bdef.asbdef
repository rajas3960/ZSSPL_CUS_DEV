projection;
strict ( 1 );
use draft;

define behavior for ZMM_UAPPS01_PV alias Header
{
  use create;
  use update;
  use delete;

  use action PostGI;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMM_UAPPS01_IPV alias Item
{
  use update;
  use delete;

  use association _Header { with draft; }
}