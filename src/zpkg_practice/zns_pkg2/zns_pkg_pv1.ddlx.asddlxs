@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Sales Order LC Utlization App',
typeNamePlural: 'Sales Order LC Utlization App',
title: { type: #STANDARD, value: 'Uuid' },
         description: { type: #STANDARD, value: 'Decs' }  } }
annotate entity ZNS_PKG_PV1
    with 
{
@UI.facet: [  { 
                      id:  'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Attachment',
//                      parentId: 'Headerinfo',
                      position:        10 
                      },
                       { 
                      id:              'Items',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           ' Items',
                      position:        20,
                      targetElement:   '_item'
                      },
                        {   
                          id: 'Hcreatedby',
                          purpose: #HEADER,
                          type: #DATAPOINT_REFERENCE,
                          position: 10,
                          targetQualifier: 'crtdby' 
                       }, 
                        {   
                          id: 'Createdon',
                          purpose: #HEADER,
                          type: #DATAPOINT_REFERENCE,
                          position: 10,
                          targetQualifier: 'crtdon' 
                       }, 
                        {   
                          id: 'Filup',
                          purpose: #HEADER,
                          type: #DATAPOINT_REFERENCE,
                          position: 10,
                          targetQualifier: 'fileupd' 
                       }
                      
                      ]
@UI.hidden: true
                      
  Uuid;
//@UI.lineItem: [{ position: 50,label: 'Attachment'  }]
@UI.identification: [{ position: 10,label: 'Attachment',importance: #HIGH },{ type: #FOR_ACTION, dataAction: 'loadexl' , label: 'Load Excel'  ,position: 10 }]
  Attachment;
  @UI.hidden: true
  Minetype;
  @UI.hidden: true
  Filename;
  @UI.lineItem: [{ position: 10,label: 'Created By'  }]
    @UI.dataPoint: { qualifier: 'crtdby', title: 'Created By'}
  Createdby;
    @UI.lineItem: [{ position: 20,label: 'Created On'  }]
       @UI.dataPoint: { qualifier: 'crtdon', title: 'Created On'}
  Createdon;
    @UI.lineItem: [{ position: 30,label: 'Last Changed By'  }]
  Lastchangedby;
  @UI.lineItem: [{ position: 40,label: 'Last Changed On'  }]
  Lastchangedon;
  @UI.hidden: true
  Status;
    
           @UI.dataPoint: { qualifier: 'fileupd', title: 'File Status'}
  Decs;
    @UI.hidden: true
  /* Associations */
  _item;
}