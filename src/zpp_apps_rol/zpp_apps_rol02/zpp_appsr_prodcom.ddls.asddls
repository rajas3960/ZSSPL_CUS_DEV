prc.OperationLeadTimeOffset,
prc.QuantityIsFixed,
prc.ScrapQtyIsNetScrap,
prc.ComponentScrapInPercent,
prc.OperationScrapInPercent,
prc.MaterialQtyToBaseQtyNmrtr,
prc.MaterialQtyToBaseQtyDnmntr,
prc.BaseUnit,
@Semantics.quantity.unitOfMeasure: 'BaseUnit'
prc.RequiredQuantity,
@Semantics.quantity.unitOfMeasure: 'BaseUnit'
prc.WithdrawnQuantity,
@Semantics.quantity.unitOfMeasure: 'BaseUnit'
prc.ConfirmedAvailableQuantity,
