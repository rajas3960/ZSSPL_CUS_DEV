@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Production Component View And Material Buring Losss'
@Metadata.ignorePropagatedAnnotations: true
define view entity zpp_appsr_prodcom as select from I_ProductionOrderComponent as prc
left outer join ZPP_MAT_RV as mat on mat.Plant = prc.Plant
{
key prc.Reservation,
key prc.ReservationItem,
key prc.ReservationRecordType,
prc.MaterialGroup,
prc.Material,
prc.Plant,
prc.ProductionOrderType,
prc.ProductionOrder,
prc.ProductionOrderSequence,
prc.SequenceCategory,
prc.ProductionOrderOperation,
prc.ProductionPlant,
prc.OrderInternalID,
prc.OrderOperationInternalID,
prc.MatlCompRequirementDate,
prc.MatlCompRequirementTime,
prc.LatestRequirementDate,
prc.ReservationIsFinallyIssued,
prc.MatlCompIsMarkedForDeletion,
prc.MaterialComponentIsMissing,
prc.IsBulkMaterialComponent,
prc.MatlCompIsMarkedForBackflush,
prc.MatlCompIsTextItem,
prc.MaterialPlanningRelevance,
prc.MatlCompIsConfigurable,
prc.MaterialComponentIsClassified,
prc.MaterialCompIsIntraMaterial,
prc.MaterialIsDirectlyProduced,
prc.MaterialIsDirectlyProcured,
prc.MaterialComponentText,
prc.MaterialComponentSecondText,
prc.MaterialComponentHasLongText,
prc.LongTextLanguage,
prc.RequirementType,
prc.SalesOrder,
prc.SalesOrderItem,
prc.WBSElementInternalID,
prc.ProductConfiguration,
prc.ChangeNumber,
prc.MaterialRevisionLevel,
prc.EffectivityParameterVariant,
prc.MaterialComponentSortText,
prc.ObjectInternalID,
prc.BillOfMaterialCategory,
prc.BillOfMaterialInternalID,
prc.BillOfMaterialVariant,
prc.BillOfMaterialItemNodeNumber,
prc.BillOfMaterialItemCategory,
prc.BillOfMaterialItemNumber,
prc.PurchasingInfoRecord,
prc.PurchasingGroup,
prc.PurchaseRequisition,
prc.PurchaseRequisitionItem,
prc.PurchasingDocument,
prc.PurchasingDocumentItem,
prc.Supplier,
prc.DeliveryDurationInDays,
prc.MaterialGoodsReceiptDuration,
prc.NumberOfOperationPriceUnits,
prc.GoodsMovementIsAllowed,
prc.StorageLocation,
prc.DebitCreditCode,
prc.GoodsMovementType,
prc.InventorySpecialStockType,
prc.InventorySpecialStockValnType,
prc.ConsumptionPosting,
prc.SupplyArea,
prc.GoodsRecipientName,
prc.UnloadingPointName,
prc.StockSegment,
prc.RequirementSegment,
prc.MaterialStaging,
prc.Batch,
prc.BatchEntryDeterminationCode,
prc.BatchSplitType,
prc.BatchMasterReservationItem,
prc.BatchClassification,
prc.MaterialCompCostingRelevancy,
prc.BusinessArea,
prc.CompanyCode,
prc.GLAccount,
prc.FunctionalArea,
prc.ControllingArea,
prc.AccountAssignmentCategory,
prc.MaterialCompIsVariableSized,
prc.VariableSizeItemUnit,
@Semantics.quantity.unitOfMeasure: 'VariableSizeItemUnit'
prc.VariableSizeItemQuantity,
prc.VariableSizeComponentUnit,
@Semantics.quantity.unitOfMeasure: 'VariableSizeComponentUnit'
prc.VariableSizeComponentQuantity,
prc.VariableSizeDimensionUnit,
@Semantics.quantity.unitOfMeasure: 'VariableSizeDimensionUnit'
prc.VariableSizeDimension1,
@Semantics.quantity.unitOfMeasure: 'VariableSizeDimensionUnit'
prc.VariableSizeDimension2,
@Semantics.quantity.unitOfMeasure: 'VariableSizeDimensionUnit'
prc.VariableSizeDimension3,
prc.VariableSizeCompFormulaKey,
prc.MaterialCompIsAlternativeItem,
prc.AlternativeItemGroup,
prc.AlternativeItemStrategy,
prc.AlternativeItemPriority,
prc.UsageProbabilityPercent,
