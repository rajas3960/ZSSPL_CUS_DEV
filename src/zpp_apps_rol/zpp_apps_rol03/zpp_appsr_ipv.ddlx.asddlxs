@Metadata.layer: #PARTNER
@UI: { headerInfo: {
typeName: 'Production Planning Creation Item',
typeNamePlural: 'Production Planning Creation Item',
title: { type: #STANDARD, value: 'Uuid'        } }     }
@UI.createHidden: true
@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZPP_APPSR_IPV
    with 
{
     @UI.facet: [ { id:              'ProductionPlanningItem',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Production Planning Selection Items',
                      position:        20 } ]
     
   @UI.hidden: true               
   Uuid;   
    @UI: { lineItem: [{ position: 10, label: 'Purchase Order'},{ type: #FOR_ACTION , dataAction: 'gt_selection', label: 'Select'}],
  identification: [{ position: 10, label: 'Purchase Order' } ] }
  @EndUserText.label: 'Purchase Order'
   Purchaseorder;
    @UI: { lineItem: [{ position: 20, label: 'Purchase Order Item'}],
