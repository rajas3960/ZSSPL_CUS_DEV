projection;
strict ( 2 );
use draft;

define behavior for ZPP_APP04_PV alias _Hdr
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZPP_APP04_IPV alias _Itm
{
  use update;
  use delete;

  use association _Header { with draft; }
}