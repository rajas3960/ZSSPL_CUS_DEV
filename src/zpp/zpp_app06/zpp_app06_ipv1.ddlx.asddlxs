@Metadata.layer: #CUSTOMER
annotate entity ZPP_APP06_IPV1 with
{
  @UI.facet: [ { id:              'Item1',
                        purpose:         #STANDARD,
                        type:            #IDENTIFICATION_REFERENCE,
                        label:           'Jobsheet Material',
                        position:        10 } ]

  @UI.hidden: true
  jobshtnum;
  @UI: { lineItem: [{ position: 10, label: 'Material'},{ type: #FOR_ACTION, dataAction: 'goodsreceipt', label: 'Goods Receipt',position: 30  }],
  identification: [{ position: 20, label: 'Material Number.' } ] }
      matnr;
  @UI.hidden: true
  plant;
//  @UI.hidden: true
  @UI: { lineItem: [{ position: 20, label: 'Material Desc.'}],
    identification: [{ position: 20, label: 'Material Desc.' } ] }
  maktx;
  @UI: { lineItem: [{ position: 30, label: 'Total Req Qty'}],
    identification: [{ position: 30, label: 'Total Req Qty' } ] }
  totreqty;
  @UI.hidden: true
  Uom;
  @UI: { lineItem: [{ position: 40, label: 'Receipt Quantity'}],
    identification: [{ position: 40, label: 'Receipt Quantity' } ] }
  receiptqty;

  @UI: { lineItem: [{ position: 50, label: 'Total Open Quantity'}],
    identification: [{ position: 50, label: 'Total Open Quantity' } ] }
  totopnqty;

  @UI: { lineItem: [{ position: 60, label: 'Total Receipt Qty'}],
    identification: [{ position: 60, label: 'Total Receipt Qty' } ] }
  totreceiptqty;
  @UI.identification: [{ position: 70, label: 'Created by' } ]
  createdby;
  @UI.identification: [{ position: 80, label: 'Created on' } ]
  createdon;
  @UI.hidden: true
  /* Associations */
  _hdr;

}

