projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZPP_APP03_PV1 //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Closejob;
  use action matval;
  use action salvalje;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action genjob;
    side effects { action matval  affects entity _Item1 ;
      action genjob affects field Jobshtnum;
      field Werks affects field Jobshtnum ;}

  use association _item1 { create; with draft; }
  use association _item2 { create; with draft; }
}

define behavior for ZPP_APP03_IPV1 //alias <alias_name>
{
  use update;
//  use delete;

  use action matvh;
  use action sovh;
  use action addmat;
  use action validreqty;
  side effects { determine action validreqty executed on field Reqty affects messages ;
   action addmat affects entity _hdr._Item2;
    }

  use association _hdr { with draft; }
}

define behavior for ZPP_APP03_IPV2 //alias <alias_name>
{
  use update;
//  use delete;

  use association _hdr { with draft; }
}