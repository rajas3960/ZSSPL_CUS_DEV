    with 
{
  @UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Selection',
                      position:        10 } ,
                    { id:              'Items',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Production Order item',
                      position:        20,
                      targetElement:   '_Mitem'} ]
@UI.hidden: true
    Uuid;
  @UI: { lineItem: [{ position: 20, label: 'Plant'}],
  identification: [{ position: 20, label: 'Plant' } ] }
    Plant;
    @UI: { lineItem: [{ position: 30, label: 'Material'}],
  identification: [{ position: 30, label: 'Material' } ] }
    Mat;
    @UI: { lineItem: [{ position: 40, label: 'Sales Order No'}],
  identification: [{ position: 40, label: 'Sales Order No' } ] }
    Salesno;
    @UI: { lineItem: [{ position: 50, label: 'Created By'}],
  identification: [{ position: 50, label: 'Created By' } ] }
    Createdby;
    @UI: { lineItem: [{ position: 60, label: 'Created On'}],
  identification: [{ position: 60, label: 'Created On' } ] }
    Createdon;
    @UI.hidden: true
    /* Associations */
    _Mitem;
    
}