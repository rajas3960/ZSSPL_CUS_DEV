projection;
strict ( 2 );
use draft;

define behavior for ZPP_APP02_HPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZPP_APP02_IPV //alias <alias_name>
{
  use update;
  use delete;

  use action Relase;
  use action PGI;
  use action GRN;

  use association _Hdr { with draft; }
  use association _Citem { create; with draft; }
}

define behavior for ZPP_APP02_IPV2 //alias <alias_name>
{
  use update;
  use delete;

  use association _Shdr { with draft; }
  use association _Hdr { with draft; }
}