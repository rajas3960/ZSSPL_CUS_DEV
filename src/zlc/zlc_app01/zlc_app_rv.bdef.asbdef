managed implementation in class zbp_lc_app_rv unique;
strict ( 2 );
with draft;
define behavior for ZLC_APP_RV alias LC //alias <alias_name>
with unmanaged save
draft table zlc_app_dftb
//persistent table zlc_app_tb

lock master total etag Lastchangedon
authorization master ( instance )
etag master Lastchangedon
{
  create;
  update;
  delete;

  field ( mandatory : create ) Lnum, Stp, Lc_Amt;
  field ( readonly : update ) Lnum, Stp, Stp_Name;
  field ( readonly ) Tot_Balance, Lc_Utilz, Createdby, Createdon, Lastchangedby, Lastchangedon;
  determination GtData1 on save { create; field Lnum , Stp ,Lc_Amt ;}
  determination GtData2 on save{ field Lc_Amt,Ldd,Lc_Expdt,Bank_Branch;}

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

 mapping for zlc_app_tb corresponding;

}