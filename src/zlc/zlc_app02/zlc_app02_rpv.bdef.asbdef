projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZLC_APP02_RPV //alias <alias_name>
{
  use create;
    use update;
    use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Line { create; with draft; }
  use association _Lineboi { create; with draft; }
}

define behavior for ZLC_APP02_IPV1 //alias <alias_name>
{
    use update;
    use delete;

  use association _Hdr { with draft; }
}
define behavior for ZLC_APP02_IPV2 //alias <alias_name>
{
    use update;
    use delete;

  use association _Hdr { with draft; }
}