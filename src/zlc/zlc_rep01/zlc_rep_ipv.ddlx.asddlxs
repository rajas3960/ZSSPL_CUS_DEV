annotate entity ZLC_REP_IPV
    with 
{
    @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'LC Utilzation Amt',
                   position:        10 } ]

@UI: { lineItem: [{ position: 30, label: 'Sales Document' }],
identification : [{ position: 30, label: 'Sales Document' }]  }
    Salesdocument;
@UI: { lineItem: [{ position: 20, label: 'LC Number' }],
identification : [{ position: 20, label: 'LC Number' }]  }
    Lnum;
@UI: { lineItem: [{ position: 10, label: 'Line Item' }],
identification : [{ position: 10, label: 'Line Item' }]  }  
    Lcline;
   @UI: { lineItem: [{ position: 40, label: 'LC Amount' }],
identification : [{ position: 40, label: 'LC Amount' }]  }   
    Lcamount;
    @UI.hidden: true
    Lcurr;
    @UI.hidden: true
    /* Associations */
    _hdr;
    
}