projection;
strict ( 2 );
use draft;

define behavior for ZSD_APP_HPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  //use action SalesOn;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _SalesItem { create; with draft; }
}

define behavior for ZSD_APP_IPV //alias <alias_name>
{
  use update;
  use delete;

  use association _SalesHeader { with draft; }
}