  field (readonly)Reldocno,Realeasdt,Maktx;
  field ( readonly : update ) Matnr,reldocs,Preparedby;
  association item { create; with draft;}
  association item2 { create; with draft;}
  mapping for zpp_app03_db corresponding;
}

