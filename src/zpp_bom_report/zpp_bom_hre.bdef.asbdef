managed implementation in class zbp_pp_bom_hre unique;
strict ( 1 );
with draft;

define behavior for ZPP_BOM_HRE alias _hdr
with unmanaged save
//persistent table zpp_bom_htb
draft table zpp_bom_hddf
lock master
total etag Createdon
authorization master ( instance )
etag master Createdon
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly, numbering : managed ) Uuid;
  field (readonly) Bomdate,Bomnumber,Drawingno,Projectname,towertypedesc,structuredesc,Purchaser,Refdocno,Bomno,bomversion;
  field (readonly:update, mandatory:create) Projectno,Towertype,Structure;
  association _item { create; with draft; }
  association _item1 { create; with draft; }
  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;
  determination gt_data1 on save { create; update; }
  determination Bomdate on modify{ create; }
  validation Validation on save { create; field Projectno, Towertype,Structure; }
  action ( features : instance ) seltitem result [1] $self;
  action ( features : instance ) selsec result [1] $self;
  action (features : instance) printBom  result [1] $self;
  side effects {  action seltitem affects entity _item;
  action selsec affects entity _item1; }
  mapping for zpp_bom_htb corresponding;
}

