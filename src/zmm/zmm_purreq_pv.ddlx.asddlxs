@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { typeName: 'Purchase Indent Report',
                typeNamePlural: 'Purchase Indent Report',
                imageUrl: 'imge',
                title: { type: #STANDARD, label: 'Purchase Indent Report', value: 'purreq_no' } },
                headerInfo.description.iconUrl: 'imge',
                
  presentationVariant: [{ sortOrder: [{ by: 'purreq_no', direction:  #ASC }] }] }
annotate entity ZMM_PURREQ_PV
    with 
{
@UI.facet: [ { id:              'ZSALES-REPORT',
                     purpose:         #STANDARD,
                     type:            #IDENTIFICATION_REFERENCE, 
                     label:           'Purchase Indent Report',
                     position: 10
                     }]
           @UI.lineItem: [{ position: 10 }] 
           @UI.identification: [{ position: 10 }]         
    @EndUserText.label: 'Purchase Requestion No'
     
  purreq_no;
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Purchase Requestion Item No'
   @UI.identification: [{ position: 20 }]    
  purreq_itno;
  @UI.lineItem: [{ position: 30 }]
  @EndUserText.label: 'Purchase Requestion Description'
  Hdesc;
  @UI.lineItem: [{ position: 40 }]
  @EndUserText.label: 'Item Text'
  itemtext;
  @UI.lineItem: [{ position: 50 }]
  @EndUserText.label: 'Requested Quantity'
  REQ;
  @UI.lineItem: [{ position: 60 }]
  @EndUserText.label: 'Base Unit'
  BaseUnit;
  @UI.lineItem: [{ position: 70 }]
  @EndUserText.label: 'Per Price'
  PERPRICE;
  @UI.lineItem: [{ position: 80 }]
  @EndUserText.label: 'Net Amount'
  NET_AMT;
  @UI.lineItem: [{ position: 90 }]
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'Cost Center'
  CostCenter;
  @UI.lineItem: [{ position: 100 }]
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'GL Acccount'
  GLAccount;
  @UI.lineItem: [{ position: 110 }]
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'Cost Name'
  COSTNAME;
 
  @UI.lineItem: [{ position: 120 }]
  @EndUserText.label: 'Remarks'
  remarks;
  @UI.lineItem: [{ position: 130 }]
  @EndUserText.label: 'Requestion Date'
  reqdate;
  @UI.lineItem: [{ position: 140 }]
  @EndUserText.label: 'Indent Date'
  indetdate;
  @UI.lineItem: [{ position: 150 }]
  @EndUserText.label: 'Department'
  dept;
//  @UI.lineItem: [{ position: 160 }]
//  @EndUserText.label: 'GR Document'
@UI.hidden: true
//  grdocument;
//  @UI.lineItem: [{ position: 170 }]
//  @EndUserText.label: 'Vendor Name'
//  vendorname;
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 190 }]
  @EndUserText.label: 'Purchase Order No'
  PurchasingDocument;
  @UI.lineItem: [{ position: 200 }]
  @EndUserText.label: 'Purchasing Document Item'
  PurchasingDocumentItem;
  @UI.lineItem: [{ position: 180 }]
  @EndUserText.label: 'Requestion Days'
  REQDays;
  @UI.lineItem: [{ position: 210 }]
  @EndUserText.label: 'image'
  imge;     
}