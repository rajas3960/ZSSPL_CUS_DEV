managed implementation in class zbp_pp_apps01_re unique;
strict ( 2 );
with draft;

define behavior for ZPP_APPS01_RE alias  _hdr
with unmanaged save
draft table zpp_apps01_db
//persistent table zpp_apps01_tb
lock master
total etag Createdon
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update(features : instance);
  delete(features : instance);

  draft action Resume;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;
  determination gt_data1 on save { create; }
  action(features : instance) gt_section result [1] $self;
  action(features : instance) get_Jc result [1] $self;
  action(features : instance) GtSect result [1] $self;
  action(features : instance) Valditaion result [1] $self ;
  action(features : instance) porel result [1] $self;
  action(features : instance) secpro result [1] $self;
  side effects {
  action gt_section affects entity _item;
  action Valditaion affects entity _item1, field checkstatus, field Totqty;
  action porel affects entity _item1,entity _item;
  action secpro affects entity _op;
  }
  field ( readonly,numbering : managed ) Uuid;
  field (mandatory) Material,Plant,Jcseries,Batch,grnno,Totqty;
  field ( readonly ) Unitwt,Jcnum,Createdby,Createdon,makts,length,checkstatus;
//  field (readonly : update) Totqty;
  association _item { create; with draft; }
  association _item1 { create; with draft; }
  association _mat {create; with draft;}
  association _op {create; with draft;}
  mapping for zpp_apps01_tb corresponding;
}

