
projection;
strict (1);
use draft;
use side effects;

define behavior for ZBOM_APP02_PV2
{
  use create;
  use update;
  use delete;

  use action loadexcl;
  side effects { action loadexcl affects entity _ITEM; }

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action create_bom;


  use association _ITEM { create; with draft; }
//  use association _HRD  { create; with draft; }
}

