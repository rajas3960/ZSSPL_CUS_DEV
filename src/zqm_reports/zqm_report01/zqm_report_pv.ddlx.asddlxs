@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { typeName: 'Project Wise Section Summary Report',
                typeNamePlural: 'Project Wise Section Summary Reports',
                title: { type: #STANDARD, label: 'Project Wise Section Summary Report', value: 'Project' } },
                presentationVariant: [{ sortOrder: [{ by: 'Project', direction:  #ASC }] }] }
annotate entity ZQM_REPORT_PV
    with 
{
    @UI.facet: [ { id:              'SectionSummary',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Project Wise Section Summary',
                   position:        10 },
                   { id:              'MarknoSummary',
                   purpose:         #STANDARD,
                   type:            #LINEITEM_REFERENCE,
                   label:           'Project Wise Mark No Summary',
                   position:        20,
                   targetElement:   'item' }]
      @UI: {  lineItem:       [ { position: 10, label: 'Sale Order' } ],
     identification: [ { position: 10, label: 'Sale Order'} ] }
  @EndUserText.label: 'Sale Order'
  @UI.selectionField: [{ position: 10 }]               
    SalesDocument;
    @UI: {  lineItem:       [ { position: 20, label: 'Project' } ],
     identification: [ { position: 20, label: 'Project'} ] }
  @EndUserText.label: 'Project'
