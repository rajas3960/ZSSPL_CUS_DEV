with draft;

define behavior for ZPP_APPS03_RV alias _hdr
with unmanaged save
//persistent table zpp_apps03_htb
draft table zpp_apps03_dtb
lock master
total etag Lastchangedon
authorization master ( instance )
etag master Lastchangedon
{
  create ( authorization : global );
  update;
  delete;
  draft action Resume;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

  determination gt_data1 on save { create; update; }

  action ( features : instance ) seltitem result [1] $self;
  action (features : instance) showleng result [1] $self;
  action (features : instance) print result [1] $self;

  side effects { action seltitem affects entity _Item;
  action showleng affects entity _Item3 ;}

  field ( readonly, numbering : managed ) Uuid;
  field ( mandatory : create ) Vrcuting, Werks, Project, Projectname;
  field ( readonly : update ) Vrcuting, Werks, Project, Projectname;
  association _Item { create; with draft; }
  association _Item2 { create; with draft; }
  association _Item3 { create; with draft; }
  mapping for zpp_apps03_htb corresponding;
}

