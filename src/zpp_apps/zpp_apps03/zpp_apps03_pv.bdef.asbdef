projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZPP_APPS03_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action seltitem;
  use action showleng;
  use action print;

  use association _Item { create; with draft; }
  use association _Item2 { create; with draft; }
  use association _Item3 { create; with draft; }

}

define behavior for ZPP_APPS03_IPV //alias <alias_name>
{
  use update;
  use delete;
  use action selectim;
  use action selectionitm;

  use association _hdr { with draft; }
}

define behavior for ZPP_APPS03_IPV2 //alias <alias_name>
{
  use update;
  use delete;

  use association _hdr { with draft; }
}
define behavior for ZPP_APPS03_IPV3 //alias <alias_name>
{
  use update;
  use delete;

  use association _hdr { with draft; }
}