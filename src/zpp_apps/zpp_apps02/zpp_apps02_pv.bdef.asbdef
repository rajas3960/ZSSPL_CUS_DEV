projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZPP_APPS02_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action seltitem;

  use association _Item1 { create; with draft; }
  use association _Item2 { create; with draft; }
  use association _lengt { create; with draft; }
  use association _stock { create; with draft; }
  use association _stocksec { create; with draft; }
}

define behavior for ZPP_APPS02_IPV //alias <alias_name>
{
  use update;
  use delete;

  use association _hdr { with draft; }
}

