@UI.headerInfo: {
    typeName: 'Details Indent',
    typeNamePlural: 'Details Indent',
    title: {
        type: #STANDARD,
        label: 'Substation',
        value: 'Purcreq'
    }
}

annotate entity ZMM_PUR_IND_P with
{

@UI.facet: [{ id: 'Purcreq',
       type: #IDENTIFICATION_REFERENCE,
       label: 'Detail' ,
       position: 10
       },{type: #DATAPOINT_REFERENCE ,
       qualifier: 'Preview',
