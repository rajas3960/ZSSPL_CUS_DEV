projection;
strict ( 2 );
use draft;

define behavior for ZPP_BOM_HPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for ZPP_BOM_IPV //alias <alias_name>
{
  use update;
  use delete;

  use association _hdr;
}